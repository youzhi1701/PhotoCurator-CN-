{
  "product": "PhotoCurator",
  "channel": "stable",
  "version": "1.5.0",
  "installer": "PhotoCurator-Setup-v1.5.0.exe",
  "upgrade_mode": "in_place",
  "same_app_id": true,
  "data_root": "%LOCALAPPDATA%/PhotoCurator/data",
  "legacy_data_root": "{app}/data",
  "migrate_legacy_config": true,
  "preserve": [
    "%LOCALAPPDATA%/PhotoCurator/data/config/library_index.sqlite3",
    "%LOCALAPPDATA%/PhotoCurator/data/config/dedup_features",
    "%LOCALAPPDATA%/PhotoCurator/data/config/recents.json",
    "%LOCALAPPDATA%/PhotoCurator/data/cache",
    "%LOCALAPPDATA%/PhotoCurator/data/logs",
    "user_photo_folders",
    "PhotoCurator_Result（照片筛选结果）",
    "custom_output_directories",
    "PhotoCurator_RecycleBin（软件回收站）"
  ],
  "replace": [
    "app"
  ],
  "notes": "v1.5.0 可直接覆盖 v1.4.2 / v1.4.1 / v1.4.0 / v1.3.0；仅替换 app。运行数据固定在 %LOCALAPPDATA%/PhotoCurator/data，首次启动会从旧 {app}/data/config 安全迁移持久化状态；缓存与日志可重建，用户照片、筛选结果、自定义输出目录及 PhotoCurator 软件回收站不受程序升级影响。"
}
